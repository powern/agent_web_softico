[Unit]
Description=Softico WordPress Guardian read-only audit
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/bin/wp-guardian --config /etc/wp-guardian/guardian.toml audit
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/wp-guardian
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
